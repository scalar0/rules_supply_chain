{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:rules-supply-chain:schema:2",
    "title": "Supply chain audit",
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/).+"
        },
        "relative_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "purl": {
            "type": "string",
            "pattern": "^pkg:[a-z][a-z0-9.+-]*/[^/?#\\s]+(/[^/?#\\s]+)*(\\?[^#\\s]+)?(#[^\\s]+)?$"
        },
        "gap": {
            "type": "object",
            "properties": {
                "code": {
                    "$ref": "#/$defs/gap_code"
                },
                "file": {
                    "type": "string",
                    "description": "The affected file path or declared file value."
                },
                "field": {
                    "type": "string",
                    "description": "The affected manifest field."
                },
                "target": {
                    "type": "string"
                },
                "purl": {
                    "$ref": "#/$defs/purl"
                }
            },
            "required": ["code"],
            "additionalProperties": false
        },
        "file_ref": {
            "type": "object",
            "properties": {
                "file": {
                    "$ref": "#/$defs/path"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "terms": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "association": {
                    "type": "string"
                }
            },
            "required": ["file", "sha256"],
            "additionalProperties": true
        },
        "declaration": {
            "type": "object",
            "properties": {
                "expression": {
                    "type": ["string", "null"]
                },
                "normalized": {
                    "type": ["string", "null"]
                },
                "parsing": {
                    "$ref": "#/$defs/parsing_code"
                },
                "normalization": {
                    "$ref": "#/$defs/normalization_code"
                },
                "terms": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "file": {
                    "$ref": "#/$defs/path"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "license_file": {
                    "type": ["string", "null"]
                }
            },
            "required": ["expression", "terms", "file", "sha256"],
            "additionalProperties": true,
            "not": {
                "required": ["normalized_expression"]
            }
        },
        "candidate": {
            "type": "object",
            "properties": {
                "file": {
                    "$ref": "#/$defs/path"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "path": {
                    "$ref": "#/$defs/relative_path"
                },
                "association": {
                    "const": "unresolved_scope"
                }
            },
            "required": ["file", "sha256", "path", "association"],
            "additionalProperties": true,
            "not": {
                "required": ["relative_path"]
            }
        },
        "source": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                },
                "manifest": {
                    "type": "string"
                },
                "url": {
                    "type": ["string", "null"]
                },
                "revision": {
                    "type": ["string", "null"]
                },
                "checksum": {
                    "type": ["string", "null"]
                },
                "declared_repository": {
                    "type": ["string", "null"]
                },
                "publisher_vcs": {
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/vcs"
                        }
                    ]
                }
            },
            "required": [],
            "additionalProperties": true
        },
        "vcs": {
            "type": "object",
            "properties": {
                "revision": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
                },
                "path_in_vcs": {
                    "type": ["string", "null"]
                },
                "file": {
                    "$ref": "#/$defs/path"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "trust": {
                    "const": "publisher_supplied"
                }
            },
            "required": ["revision", "file", "sha256", "trust"],
            "additionalProperties": false
        },
        "licenses": {
            "type": "object",
            "properties": {
                "terms": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "declarations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/declaration"
                    }
                },
                "texts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/file_ref"
                    }
                },
                "notices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/file_ref"
                    }
                },
                "candidates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/candidate"
                    }
                }
            },
            "required": [
                "terms",
                "declarations",
                "texts",
                "notices",
                "candidates"
            ],
            "additionalProperties": false
        },
        "package": {
            "type": "object",
            "properties": {
                "purl": {
                    "$ref": "#/$defs/purl"
                },
                "provider": {
                    "type": "string"
                },
                "attributes": {
                    "type": "object"
                },
                "version": {
                    "type": ["string", "null"]
                },
                "versions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "release": {
                    "type": ["string", "null"]
                },
                "revision": {
                    "type": ["string", "null"]
                },
                "remote": {
                    "type": ["string", "null"]
                },
                "targets": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "licenses": {
                    "$ref": "#/$defs/licenses"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/source"
                    }
                },
                "artifacts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/file_ref"
                    }
                },
                "overlays": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/file_ref"
                    }
                },
                "gaps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/gap"
                    },
                    "minItems": 1
                },
                "name": {
                    "type": ["string", "null"]
                },
                "repository_url": {
                    "type": ["string", "null"]
                }
            },
            "required": [
                "purl",
                "provider",
                "version",
                "versions",
                "release",
                "revision",
                "remote",
                "targets",
                "licenses",
                "overlays"
            ],
            "additionalProperties": false
        },
        "edge": {
            "type": "object",
            "properties": {
                "target": {
                    "type": "string"
                },
                "attribute": {
                    "type": "string"
                }
            },
            "required": ["target", "attribute"],
            "additionalProperties": false
        },
        "target": {
            "type": "object",
            "properties": {
                "label": {
                    "type": "string"
                },
                "kind": {
                    "type": "string"
                },
                "helper": {
                    "type": "boolean"
                },
                "deps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/edge"
                    }
                },
                "files": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "packages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/purl"
                    }
                },
                "licenses": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "legal_scopes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/legal_scope"
                    }
                },
                "source_records": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "label",
                "kind",
                "helper",
                "deps",
                "files",
                "packages",
                "licenses"
            ],
            "additionalProperties": false
        },
        "evidence": {
            "type": "object",
            "properties": {
                "path": {
                    "$ref": "#/$defs/path"
                },
                "kind": {
                    "enum": ["source", "text", "metadata"]
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "content": {}
            },
            "required": ["path", "kind", "sha256", "content"],
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "text"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "content": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "source"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "content": {
                                "type": "null"
                            }
                        }
                    }
                }
            ]
        },
        "metadata": {
            "type": "object",
            "properties": {
                "$schema": {
                    "const": "schema.json#metadata"
                },
                "scope": {
                    "type": "string"
                },
                "roots": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "expected": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/purl"
                    }
                },
                "packages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/package"
                    }
                },
                "targets": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/target"
                    }
                },
                "files": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/evidence"
                    }
                },
                "unassigned": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/file_ref"
                    }
                },
                "gaps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/gap"
                    },
                    "minItems": 1
                }
            },
            "required": [
                "$schema",
                "scope",
                "roots",
                "expected",
                "packages",
                "targets",
                "files",
                "unassigned"
            ],
            "additionalProperties": false,
            "$anchor": "metadata"
        },
        "coverage": {
            "type": "object",
            "properties": {
                "$schema": {
                    "const": "schema.json#coverage"
                },
                "scope": {
                    "type": "string"
                },
                "missing": {
                    "type": "object",
                    "properties": {
                        "identities": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "texts": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "terms": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        }
                    },
                    "required": [],
                    "additionalProperties": false,
                    "minProperties": 1
                },
                "conflicts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "gaps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/gap"
                    },
                    "minItems": 1
                },
                "assessment": {
                    "type": "object",
                    "properties": {
                        "inputs": {
                            "const": "declared_bazel_inputs",
                            "description": "The audit examines only declared Bazel inputs."
                        },
                        "completeness": {
                            "const": "not_established",
                            "description": "The audit does not establish that all legal evidence is present."
                        },
                        "policy": {
                            "const": "not_evaluated",
                            "description": "The audit does not evaluate license policy."
                        }
                    },
                    "required": ["inputs", "completeness", "policy"],
                    "additionalProperties": false
                }
            },
            "required": ["$schema", "scope", "assessment"],
            "additionalProperties": false,
            "$anchor": "coverage"
        },
        "check": {
            "type": "object",
            "properties": {
                "$schema": {
                    "const": "schema.json#check"
                },
                "scope": {
                    "type": "string"
                },
                "valid": {
                    "const": true
                }
            },
            "required": ["$schema", "scope", "valid"],
            "additionalProperties": false,
            "$anchor": "check"
        },
        "input_file": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string"
                },
                "logical": {
                    "$ref": "#/$defs/path"
                }
            },
            "required": ["path", "logical"],
            "additionalProperties": false
        },
        "inventory_node": {
            "type": "object",
            "properties": {
                "label": {
                    "type": "string"
                },
                "kind": {
                    "type": "string"
                },
                "helper": {
                    "type": "boolean"
                },
                "dependencies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/edge"
                    }
                },
                "files": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "packages": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "licenses": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "legal_scopes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/legal_scope"
                    }
                },
                "source_records": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "label",
                "kind",
                "helper",
                "dependencies",
                "files",
                "packages",
                "licenses"
            ],
            "additionalProperties": false
        },
        "manifest_file": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string"
                },
                "logical": {
                    "$ref": "#/$defs/path"
                },
                "kind": {
                    "enum": ["source", "text", "metadata"]
                }
            },
            "required": ["path", "logical", "kind"],
            "additionalProperties": false
        },
        "inventory_file": {
            "type": "object",
            "properties": {
                "logical": {
                    "$ref": "#/$defs/path"
                },
                "kind": {
                    "enum": ["source", "text", "metadata"]
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "content": {}
            },
            "required": ["logical", "kind", "sha256", "content"],
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "text"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "content": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "source"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "content": {
                                "type": "null"
                            }
                        }
                    }
                }
            ]
        },
        "adapter_text": {
            "type": "object",
            "properties": {
                "file": {
                    "$ref": "#/$defs/path"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "content": {
                    "type": "string"
                }
            },
            "required": ["file", "sha256", "content"],
            "additionalProperties": false
        },
        "adapter_declaration": {
            "type": "object",
            "properties": {
                "expression": {
                    "type": ["string", "null"]
                },
                "normalized_expression": {
                    "type": ["string", "null"]
                },
                "parsing": {
                    "$ref": "#/$defs/parsing_code"
                },
                "normalization": {
                    "$ref": "#/$defs/normalization_code"
                },
                "terms": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "file": {
                    "$ref": "#/$defs/path"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "license_file": {
                    "type": ["string", "null"]
                }
            },
            "required": ["expression", "terms", "file", "sha256"],
            "additionalProperties": true
        },
        "adapter_candidate": {
            "type": "object",
            "properties": {
                "file": {
                    "$ref": "#/$defs/path"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "relative_path": {
                    "$ref": "#/$defs/relative_path"
                },
                "association": {
                    "const": "unresolved_scope"
                }
            },
            "required": ["file", "sha256", "relative_path", "association"],
            "additionalProperties": true
        },
        "adapter_package": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string"
                        },
                        "purl": {
                            "type": "null"
                        },
                        "gaps": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/gap"
                            }
                        }
                    },
                    "required": ["target", "purl", "gaps"],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string"
                        },
                        "purl": {
                            "$ref": "#/$defs/purl"
                        },
                        "version": {
                            "type": "string"
                        },
                        "source": {
                            "$ref": "#/$defs/source"
                        },
                        "declarations": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/adapter_declaration"
                            }
                        },
                        "license_evidence": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/file_ref"
                            }
                        },
                        "notice_evidence": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/file_ref"
                            }
                        },
                        "legal_file_candidates": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/adapter_candidate"
                            }
                        },
                        "texts": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/adapter_text"
                            }
                        },
                        "gaps": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/gap"
                            }
                        }
                    },
                    "required": [
                        "target",
                        "purl",
                        "version",
                        "source",
                        "declarations",
                        "license_evidence",
                        "notice_evidence",
                        "texts",
                        "gaps"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "adapter": {
            "type": "object",
            "properties": {
                "$schema": {
                    "const": "urn:rules-supply-chain:schema:2#adapter"
                },
                "packages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/adapter_package"
                    }
                }
            },
            "required": ["$schema", "packages"],
            "additionalProperties": false,
            "$anchor": "adapter"
        },
        "manifest": {
            "type": "object",
            "properties": {
                "$schema": {
                    "const": "urn:rules-supply-chain:schema:2#manifest"
                },
                "scope": {
                    "type": "string"
                },
                "expected_packages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "roots": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/inventory_node"
                    }
                },
                "overlay_evidence": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "package_evidence": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "files": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/manifest_file"
                    }
                }
            },
            "required": [
                "$schema",
                "scope",
                "expected_packages",
                "roots",
                "nodes",
                "overlay_evidence",
                "package_evidence",
                "files"
            ],
            "additionalProperties": false,
            "$anchor": "manifest"
        },
        "inventory": {
            "type": "object",
            "properties": {
                "$schema": {
                    "const": "urn:rules-supply-chain:schema:2#inventory"
                },
                "scope": {
                    "type": "string"
                },
                "expected_packages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "roots": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/inventory_node"
                    }
                },
                "overlay_evidence": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "package_evidence": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "files": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/inventory_file"
                    }
                }
            },
            "required": [
                "$schema",
                "scope",
                "expected_packages",
                "roots",
                "nodes",
                "overlay_evidence",
                "package_evidence",
                "files"
            ],
            "additionalProperties": false,
            "$anchor": "inventory"
        },
        "gap_code": {
            "description": "A discovery problem. Use the code for decisions. Context fields identify the affected input.",
            "oneOf": [
                {
                    "const": "missing_manifest",
                    "description": "The target has no package manifest. Declare the manifest as a metadata input."
                },
                {
                    "const": "invalid_manifest",
                    "description": "The package manifest cannot be read or parsed as TOML."
                },
                {
                    "const": "missing_package",
                    "description": "The manifest has no package table."
                },
                {
                    "const": "invalid_workspace",
                    "description": "The workspace manifest cannot be read or parsed as TOML."
                },
                {
                    "const": "missing_workspace",
