load("//:defs.bzl", "report")
load(":support.bzl", "report_test")

filegroup(
    name = "defaults",
    srcs = ["NOTICE"],
)

report(
    name = "fixture_report",
    evidence = ["NOTICE"],
    expected_packages = [
        "pkg:generic/fixture-override",
        "pkg:generic/legacy@1.2.3",
    ],
    overlay_evidence = {"pkg:generic/fixture-override": ["origin.txt"]},
    required_overlay_packages = ["pkg:generic/fixture-override"],
    roots = [
        ":defaults",
        "//tests/fixtures:corpus",
    ],
)

report(
    name = "empty_report",
    roots = [],
)

report_test(
    name = "report_test",
    size = "small",
    data = [
        ":empty_report",
        ":fixture_report",
        "//private:check.jq",
        "//private:contents.jq",
        "//private:coverage.jq",
        "//private:digest.sh",
        "//private:metadata.jq",
        "//private:notices.jq",
        "//private:schema.jq",
    ],
    script = "report_test.sh",
)

report_test(
    name = "adapter_test",
    size = "small",
    data = [
        ":fixture_report_inventory",
        "//:schema",
        "//private:check.jq",
        "//private:coverage.jq",
        "//private:metadata.jq",
    ],
    script = "adapter_test.sh",
)
